# ==============================================================================
# EVENTFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your respective credentials
# ==============================================================================

# Serverless PostgreSQL (Neon or standard Postgres connection pool)
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Next.js Environment & Auth fallback
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_random_32_char_secret"

# Clerk Authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key_here"
CLERK_SECRET_KEY="your_clerk_secret_key_here"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/user/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/user/register"

# Google OAuth (Optional / if using NextAuth fallback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS S3 Storage (For Event Banners & Direct Client Uploads via Presigned URLs)
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="your-eventflow-bucket"

# Razorpay Payments Gateway (https://dashboard.razorpay.com)
NEXT_PUBLIC_RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET=""

# Groq Cloud AI (Llama-powered Event Copywriting - https://console.groq.com)
GROQ_API_KEY="your_groq_api_key_here"
